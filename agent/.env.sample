# Gemini (Google AI Studio)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Personal-number allowlist: comma-separated international numbers, digits only.
# Example: 919876543210
WHATSAPP_ALLOWED_NUMBERS=

# Persistent disk paths (Render disk is mounted at /var/data).
MEMORY_DB_URL=file:/var/data/memory.db
SESSION_PROFILE_DB_URL=file:/var/data/session-profile.db
KNOWLEDGE_DB_URL=file:/var/data/knowledge.db
