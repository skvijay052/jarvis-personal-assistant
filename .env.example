# Meta WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-secret
WHATSAPP_APP_SECRET=your-meta-app-secret
WHATSAPP_ACCESS_TOKEN=your-system-user-permanent-token
WHATSAPP_PHONE_NUMBER_ID=your-cloud-api-phone-number-id
WHATSAPP_GRAPH_API_VERSION=v23.0

# Comma-separated E.164 numbers, digits only; example: 919876543210
# Leave unset until your own number is confirmed. Empty allowlist blocks all senders.
WHATSAPP_ALLOWED_NUMBERS=

# Supabase server credentials (service-role key must NEVER be exposed to a browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
